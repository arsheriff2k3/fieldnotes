# Copy this file to .env and replace the placeholder values.
# Never commit or share your real .env file.

SERVERPOD_PASSWORD_geminiApiKey='YOUR_GEMINI_API_KEY'
SERVERPOD_PASSWORD_geminiModel='gemini-3.8-flash'
# Optional free-tier fallback when Gemini returns HTTP 429 (quota exhausted).
# SERVERPOD_PASSWORD_groqApiKey='YOUR_GROQ_API_KEY'
# Set to 'groq' to try Groq first; omitted defaults to 'gemini'.
# SERVERPOD_PASSWORD_aiPrimaryProvider='groq'

SERVERPOD_PASSWORD_razorpayKeyId='rzp_test_YOUR_KEY_ID'
SERVERPOD_PASSWORD_razorpayKeySecret='YOUR_RAZORPAY_TEST_SECRET'

# Gmail account used only by the server to email signup and password-reset codes.
# Use a Google App Password, not the normal Google account password.
SERVERPOD_PASSWORD_smtpUsername='YOUR_SENDING_GMAIL_ADDRESS'
SERVERPOD_PASSWORD_smtpAppPassword='YOUR_16_CHARACTER_APP_PASSWORD'

# Trusted auth UUIDs that can review and record manual bank payouts.
# Empty by default. Set actual operator UUIDs and restart the server.
# FIELDNOTE_PAYOUT_OPERATOR_IDS='uuid-of-trusted-operator'
# Firebase Android push: server-only JSON service-account credentials. Configure
# SERVERPOD_PASSWORD_firebaseServiceAccountJson in the runtime secret manager or
# ignored config/passwords.yaml. Never include it in Flutter assets or Git.
# See docs/NOTIFICATIONS.md for the Android setup and migration.
